{
  "name": "stotoon-beta",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/homepage/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stotoon-beta",
      "database_id": "e32fe908-1bdc-401d-9881-fb27d1cb8ea9",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "BETA_OPEN": "0",
    "OPERATOR_NAME": "parkjihoon98",
    "PRIVACY_APPROVED": "0",
    "MAIL_FROM": "onboarding@resend.dev",
    "BETA_END_AT": "",
    "PREVIEW_NOTIFY_AFTER": "2026-11-21T13:22:00.000Z",
    "DAILY_SIGNUP_LIMIT": "50"
  },
  "workers_dev": true,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "2026112101",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
